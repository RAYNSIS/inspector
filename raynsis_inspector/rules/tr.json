      "lang": "tr",
      "event": "reply",
      "action": "deny",
      "pattern": "(?i)\\b(yayınladı[mk]|yayına\\s+aldı[mk]|canlıya\\s+aldı[mk]|düzeltti[mk]|onardı[mk]|yükledi[mk]|gönderdi[mk]|birleştirdi[mk]|deploy\\s+etti[mk]|push\\s+etti[mk]|commit\\s+etti[mk]|commitledi[mk]|push['’]?ladı[mk]|merge\\s+etti[mk]|merge['’]?ledi[mk]|(?:paket\\w*|bağımlılık\\w*|kütüphane\\w*|eklenti\\w*|modül\\w*|sürüm\\w*|araç\\w*|aracı|sunucu\\w*|ortam\\w*|kanca\\w*)(?:\\s+ile)?\\s+kurdu[mk]|kurulumu\\s+(?:yaptı[mk]|tamamladı[mk])|yayınlandı|yayına\\s+alındı|canlıya\\s+alındı|düzeltildi|gönderildi|kaydetti[mk]|(?<!gibi\\s)(?<!şöyle\\s)güncelledi[mk](?![^.!?\\n]*?(?:aşağıda|yukarıda|şöyle|:))|(?<!gibi\\s)(?<!şöyle\\s)güncellendi(?![^.!?\\n]*?(?:aşağıda|yukarıda|şöyle|:)))\\b(?!\\s*m[iıuü]\\b)",
      "needs_turn": ".",
